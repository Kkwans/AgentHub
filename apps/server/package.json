    "@agenthub/agent-core": "workspace:*",
    "@agenthub/db": "workspace:*",
    "@agenthub/shared": "workspace:*",
    "cors": "2.8.6",
    "diff": "9.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.1"
  }

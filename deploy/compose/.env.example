AGENTHUB_IMAGE=agenthub:0.6.0-nas.36
AGENTHUB_VERSION=0.6.0
AGENTHUB_REVISION=ac20416
AGENTHUB_SOURCE_DIR=/volume2/Project/AgentHub
AGENTHUB_BIND_ADDRESS=192.168.5.110
AGENTHUB_PORT=3210
# 取消 Run 等待 Agent 确认的最长时间（毫秒，1000-120000；默认 10000）
AGENTHUB_RUN_CANCEL_TIMEOUT_MS=10000
AGENTHUB_APPROVAL_DELIVERY_TIMEOUT_MS=10000
AGENTHUB_SECURE_TRANSPORT=false
AGENTHUB_PROJECT_ROOT=/volume2/Project
AGENTHUB_DATA_DIR=/volume2/Project/.agenthub/central/data
AGENTHUB_WORKTREE_ROOT=/volume2/Project/.agenthub/central/worktrees
AGENTHUB_TMP_DIR=/volume2/Project/.agenthub/central/tmp
AGENTHUB_CODEX_HOME=/home/Kkwans/.codex
AGENTHUB_GIT_CONFIG=/home/Kkwans/.gitconfig
AGENTHUB_PROJECT_OWNER_UID=1000
AGENTHUB_PROJECT_OWNER_GID=10
AGENTHUB_LOG_LEVEL=info

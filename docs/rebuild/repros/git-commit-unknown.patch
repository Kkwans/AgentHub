+// @vitest-environment jsdom
+import '@testing-library/jest-dom/vitest';
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, expect, it, vi } from 'vitest';
+import { GitChangesTree } from './GitChangesTree';
+import { ApiError } from '../../../lib/api';
+const query = <T,>(data: T) => ({ data, error: null, isLoading: false, refetch: vi.fn() });
+afterEach(cleanup);
+function setup() {
+  const onCommit = vi.fn(async () => {
+    throw new ApiError('HTTP_ERROR', '请求失败，请稍后重试。', 0);
+  });
+  render(
+    <GitChangesTree
+      status={query({
+        clean: false,
+        branch: 'main',
+        entries: [{ index: ' ', worktree: 'M', path: 'one.txt' }],
+      })}
+      diff={query({ patch: '', truncated: false, staged: false })}
+      commits={query([])}
+      branches={query([])}
+      onCommit={onCommit}
+      stagedDiff={false}
+      onStagedDiffChange={vi.fn()}
+      whitespace="default"
+      onWhitespaceChange={vi.fn()}
+    />,
+  );
+  fireEvent.click(screen.getByRole('checkbox', { name: '选择 one.txt' }));
+  fireEvent.change(screen.getByRole('textbox', { name: '提交说明' }), {
+    target: { value: 'same requested message' },
+  });
+  fireEvent.click(screen.getByRole('button', { name: '提交所选文件 (1)' }));
+  return onCommit;
+}
+it('current UI permits a second manual call after transport uncertainty (characterization, not safe behavior)', async () => {
+  const onCommit = setup();
+  await waitFor(() => expect(screen.getByRole('button', { name: '重试提交' })).toBeEnabled());
+  expect(screen.getByRole('alert')).toHaveTextContent('请求失败，请稍后重试');
+  fireEvent.click(screen.getByRole('button', { name: '重试提交' }));
+  await waitFor(() => expect(onCommit).toHaveBeenCalledTimes(2));
+  expect(onCommit.mock.calls[0]).toEqual(onCommit.mock.calls[1]);
+});
+it('desired safety contract: unknown transport outcome must not expose an enabled retry [EXPECTED RED]', async () => {
+  setup();
+  await waitFor(() => expect(screen.getByRole('alert')).toBeVisible());
+  expect(screen.getByRole('button', { name: '重试提交' })).toBeDisabled();
+});

@@ -0,0 +1,78 @@
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { runProcess } from '@agenthub/agent-core';
+import { expect, it, vi } from 'vitest';
+import { GitService } from './git-service.js';
+
+it('real temporary Git commit succeeds before simulated response loss, and a later changed path can be committed by retry', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'agenthub-commit-response-repro-'));
+  const git = async (...args: string[]) => {
+    const result = await runProcess({
+      executable: '/usr/bin/git',
+      args: ['-C', root, ...args],
+      timeoutMs: 5000,
+      maxOutputBytes: 10000,
+    });
+    expect(result.exitCode).toBe(0);
+    return result.stdout.trim();
+  };
+  try {
+    await git('init');
+    await git('config', 'user.name', 'Isolated Repro');
+    await git('config', 'user.email', 'repro@example.invalid');
+    await writeFile(join(root, 'one.txt'), 'baseline\n');
+    await git('add', '--', 'one.txt');
+    await git('commit', '-m', 'baseline');
+    const before = await git('rev-parse', 'HEAD');
+    const service = new GitService(
+      {
+        get: vi.fn(async () => ({
+          id: 'fixture',
+          repoKind: 'GIT',
+          targetId: 'local',
+          realRootPath: root,
+        })),
+      } as unknown as ConstructorParameters<typeof GitService>[0],
+      { create: vi.fn() } as unknown as ConstructorParameters<typeof GitService>[1],
+    );
+    const payload = {
+      mode: 'SELECTED' as const,
+      paths: ['one.txt'],
+      message: 'same requested message',
+    };
+    await writeFile(join(root, 'one.txt'), 'first edit\n');
+    let completed: Awaited<ReturnType<GitService['commit']>> | undefined;
+    const lostResponse = async () => {
+      completed = await service.commit('fixture', payload);
+      throw new Error('simulated transport response loss after service completion');
+    };
+    await expect(lostResponse()).rejects.toThrow('simulated transport response loss');
+    const first = await git('rev-parse', 'HEAD');
+    expect(first).not.toBe(before);
+    expect(completed).toMatchObject({ beforeSha: before, sha: first });
+    expect((await service.status('fixture')).clean).toBe(true);
+    // No change would normally be rejected by Git. This second edit is intentional,
+    // representing another actor changing the same selected path before manual retry.
+    await writeFile(join(root, 'one.txt'), 'later independent edit\n');
+    const retried = await service.commit('fixture', payload);
+    expect(retried.beforeSha).toBe(first);
+    expect(retried.sha).not.toBe(first);
+    expect(await git('rev-list', '--count', 'HEAD')).toBe('3');
+    expect(await git('show', 'HEAD:one.txt')).toBe('later independent edit');
+    await writeFile(
+      '/tmp/agenthub-commit-response-evidence.json',
+      JSON.stringify({
+        before,
+        first,
+        second: retried.sha,
+        samePayload: payload,
+        commits: 3,
+        transport: 'simulated after real service success',
+        database: 'project repository stub only; real git commands',
+      }),
+    );
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});

AGENTHUB_HOST=127.0.0.1
AGENTHUB_PORT=3210
AGENTHUB_DATA_DIR=.agenthub
# 非 loopback 监听时必须配置。服务仅保存 token hash。
# AGENTHUB_AUTH_MODE=token
# AGENTHUB_BOOTSTRAP_TOKEN=请使用高熵随机值并通过环境或 secret manager 注入
# PostgreSQL 模式可选；未设置时使用 PGlite 文件模式。
# DATABASE_URL=postgresql://agenthub:agenthub@127.0.0.1:5432/agenthub

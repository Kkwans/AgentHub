{
  "name": "agenthub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @agenthub/server --filter @agenthub/web dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "corepack pnpm build && corepack pnpm exec playwright test --config=playwright.real.config.ts",
    "test:visual:real": "node scripts/qa/real-deployment-visual.cjs",
    "qa:geometry": "node scripts/qa/geometry-audit.cjs",
    "qa:css-budget": "node scripts/qa/css-budget.mjs",
    "qa:performance": "node scripts/qa/performance-gate.cjs",
    "test:qa": "node --test scripts/qa/*.test.cjs",
    "release:version-truth": "node scripts/release/check-version-truth.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:reset-project-data": "tsx scripts/ops/reset-project-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
